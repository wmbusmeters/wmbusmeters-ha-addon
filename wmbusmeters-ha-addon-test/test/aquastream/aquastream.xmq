driver{name=aquastream meter_type=WaterMeter default_fields=name,id,total_m3,timestamp detect{mvt=IMT,01,07}library{use=total_m3,meter_datetime,target_m3,target_date}flags{flag{name=TAMPER info='Tampering with the meter has been detected.'}flag{name=BURST info='A pipe burst has been detected.'}flag{name=LEAK info='A leak has been detected.'}flag{name=NO_FLOW info='There is no flow of water.'}flag{name=LOW_BATTERY info='The battery is low.'}flag{name=REVERSE info='The water flows through the meter in the wrong direction.'}flag{name=OVERFLOW info='The flow is above the maximum flow rate of the meter.'}}fields{field{name=status quantity=Flags info=status_and_error_flags attributes=INCLUDE_TPL_STATUS match{measurement_type=Instantaneous vif_range=ErrorFlags}lookup{name=ERROR_FLAGS map_type=BitToString mask_bits=0xffff default_message=OK map{name=TAMPER info='Tampering alarm - No PMK detection (cannot read wheel position).'value=0x1 test=Set}map{name=BURST info='Flow rate higher than the set burst limit.'value=0x4 test=Set}map{name=LEAK info='Detection of a leak.'value=0x8 test=Set}map{name=NO_FLOW info='No flow during the set time.'value=0x80 test=Set}map{name=LOW_BATTERY info='Low Battery – 18 months before end of life.'value=0x100 test=Set}map{name=REVERSE info='Negative flow rate beyond detection threshold (flow rate/time).'value=0x200 test=Set}map{name=OVERFLOW info='Flow rate higher than the set overflow limit.'value=0x400 test=Set}}}field{name=total_backwards quantity=Volume match{measurement_type=Instantaneous vif_range=Volume tariff_nr=1}}field{name=battery quantity=Time display_unit=y force_scale=0.0027397260273972603 match{measurement_type=Instantaneous difvifkey=02FD74}}}}
