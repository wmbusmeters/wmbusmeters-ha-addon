xsl:stylesheet(version                 = 1.0
               xml:space               = preserve
               exclude-result-prefixes = this
               xmlns:xsl               = http://www.w3.org/1999/XSL/Transform
               xmlns:this              = urn:this)
{
    xsl:param(name = drv)
    xsl:variable(name   = drvx
                 select = 'document($drv)')
    xsl:variable(name = meter_id
                 select = /telegram/id)
    xsl:variable(name = meter_name
                 select = /telegram/name)
    /* wmbusmeters unit suffix -> unit string accepted by HA.
       Only units listed here are treated as physical units,
       all other suffixes (counter, nr, factor...) are left unit-less. */
    this:tohrunit {
        entry(key = pct) = %
        entry(key = m3) = m³
        entry(key = l) = L
        entry(key = m3h) = m³/h
        entry(key = lh) = L/h
        entry(key = c) = °C
        entry(key = f) = °F
        entry(key = k) = K
        entry(key = dbm) = dBm
        entry(key = s) = s
        entry(key = min) = min
        entry(key = h) = h
        entry(key = d) = d
        entry(key = y) = years
        entry(key = hca) = hca
        entry(key = w) = W
        entry(key = kw) = kW
        entry(key = wh) = Wh
        entry(key = kwh) = kWh
        entry(key = mj) = MJ
        entry(key = gj) = GJ
        entry(key = gcal) = Gcal
        entry(key = kvarh) = kvarh
        entry(key = kvar) = kvar
        entry(key = kva) = kVA
        entry(key = v) = V
        entry(key = a) = A
        entry(key = hz) = Hz
        entry(key = bar) = bar
        entry(key = pa) = Pa
        entry(key = rh) = %
    }
    this:tostateclass {
        entry(key = Instant) = measurement
        entry(key = Net) = total
        entry(key = Increasing) = total_increasing
    }
    /* wmbusmeters unit suffix -> HA device class. Keyed on the unit (not the quantity)
       so that the device class is only set when HA accepts the unit for it. */
    this:todeviceclass {
        entry(key = m3) = volume
        entry(key = l) = volume
        entry(key = m3h) = volume_flow_rate
        entry(key = lh) = volume_flow_rate
        entry(key = c) = temperature
        entry(key = f) = temperature
        entry(key = k) = temperature
        entry(key = dbm) = signal_strength
        entry(key = s) = duration
        entry(key = min) = duration
        entry(key = h) = duration
        entry(key = d) = duration
        entry(key = w) = power
        entry(key = kw) = power
        entry(key = wh) = energy
        entry(key = kwh) = energy
        entry(key = mj) = energy
        entry(key = gj) = energy
        entry(key = gcal) = energy
        entry(key = kvarh) = reactive_energy
        entry(key = kvar) = reactive_power
        entry(key = kva) = apparent_power
        entry(key = v) = voltage
        entry(key = a) = current
        entry(key = hz) = frequency
        entry(key = bar) = pressure
        entry(key = pa) = pressure
        entry(key = rh) = humidity
    }
    /* HA rejects state_class measurement for these device classes. */
    this:totalonly {
        entry(key = volume) = total
        entry(key = water) = total
        entry(key = gas) = total
        entry(key = energy) = total
        entry(key = reactive_energy) = total
    }
    xsl:template(match = /)
    {
        _ {
            xsl:variable(name   = manufacturer
                         select = $drvx/driver/manufacturer)
            xsl:variable(name   = mvt
                         select = telegram/mvt)
            xsl:variable(name   = driver
                         select = telegram/driver)
            xsl:variable(name   = metertype
                         select = $drvx/driver/meter_type)
            /* Now iterate over all details. This list all possible fields
               in the telegram and provide their:
               quantity
               unit
               info
               change
            */
            xsl:for-each(select = telegram/details/*)
            {
                xsl:variable(name   = field_name
                             select = 'name()')
                xsl:variable(name   = unit
                             select = ./unit)
                xsl:variable(name   = change
                             select = ./change)
                xsl:variable(name   = quantity
                             select = ./quantity)
                xsl:variable(name   = base
                             select = "substring-before($field_name, concat('_', $unit))")
                xsl:variable(name   = hrunit
                             select = "document('')/*/this:tohrunit/entry[@key = $unit]")
                xsl:variable(name   = unitclass
                             select = "document('')/*/this:todeviceclass/entry[@key = $unit]")
                /* text: status strings etc, datetime/date: points in time, number: everything else. */
                xsl:variable(name = kind) {
                    xsl:choose {
                        xsl:when(test = "$quantity = 'Text'") {
                            xsl:text = text
                        }
                        xsl:when(test = "$quantity = 'PointInTime' and $unit = 'datetime'") {
                            xsl:text = datetime
                        }
                        xsl:when(test = "$quantity = 'PointInTime' and $unit = 'date'") {
                            xsl:text = date
                        }
                        xsl:when(test = "$quantity = 'PointInTime'") {
                            xsl:text = text
                        }
                        xsl:otherwise {
                            xsl:text = number
                        }
                    }
                }
                xsl:variable(name = deviceclass) {
                    xsl:choose {
                        xsl:when(test = "$kind = 'datetime'") {
                            xsl:text = timestamp
                        }
                        xsl:when(test = "$kind = 'date'") {
                            xsl:text = date
                        }
                        xsl:when(test = "$kind != 'number'") {
                        }
                        xsl:when(test = "$metertype = 'WaterMeter' and $unitclass = 'volume'") {
                            xsl:text = water
                        }
                        xsl:when(test = "$metertype = 'GasMeter' and $unitclass = 'volume'") {
                            xsl:text = gas
                        }
                        xsl:otherwise {
                            xsl:value-of(select = $unitclass)
                        }
                    }
                }
                xsl:variable(name = stateclass) {
                    xsl:variable(name   = sc
                                 select = "document('')/*/this:tostateclass/entry[@key = $change]")
                    xsl:variable(name   = totalonly
                                 select = "document('')/*/this:totalonly/entry[@key = $deviceclass]")
                    /* Most drivers do not set change yet, then it defaults to Instant.
                       Counters are recognized by name/unit until the drivers are updated. */
                    xsl:choose {
                        xsl:when(test = "$kind != 'number'") {
                        }
                        xsl:when(test = "$sc = 'measurement' and $totalonly != '' and starts-with($field_name, 'total')") {
                            xsl:text = total_increasing
                        }
                        xsl:when(test = "$sc = 'measurement' and $totalonly != ''") {
                            xsl:value-of(select = $totalonly)
                        }
                        xsl:when(test = "$sc = 'measurement' and $unit = 'hca'") {
                            xsl:text = total_increasing
                        }
                        xsl:otherwise {
                            xsl:value-of(select = $sc)
                        }
                    }
                }
                /* Strip the unit suffix from the name only for real units,
                   otherwise historic_m3 and historic_datetime would both be named "historic". */
                xsl:variable(name = display_name) {
                    xsl:choose {
                        xsl:when(test = "$hrunit != '' and $base != ''") {
                            xsl:value-of(select = 'translate($base, "_", " ")')
                        }
                        xsl:otherwise {
                            xsl:value-of(select = 'translate($field_name, "_", " ")')
                        }
                    }
                }
                /* The status text becomes a problem binary sensor: off while the status is OK,
                   on otherwise, with the status text kept as an attribute. */
                xsl:variable(name   = problem
                             select = "$field_name = 'status' or $field_name = 'current_status'")
                xsl:element(name = '{$field_name}')
                {
                    xsl:choose {
                        xsl:when(test = $problem) {
                            component = binary_sensor
                        }
                        xsl:otherwise {
                            component = sensor
                        }
                    }
                    discovery_payload {
                        device {
                            identifiers(A)
                            {
                                _ {
                                    'wmbusmeters_'
                                    xsl:value-of(select = $meter_id)
                                }
                            }
                            manufacturer {
                                xsl:value-of(select = $manufacturer)
                            }
                            model {
                                xsl:value-of(select = $mvt)
                            }
                            name {
                                xsl:value-of(select = $meter_name)
                            }
                            serial_number {
                                xsl:value-of(select = $meter_id)
                            }
                        }
                        name {
                            xsl:value-of(select = $display_name)
                        }
                        unique_id {
                            'wmbusmeters_'
                            xsl:value-of(select = $meter_id)
                            '_'
                            xsl:value-of(select = $field_name)
                        }
                        state_topic {
                            'wmbusmeters/'
                            xsl:value-of(select = $meter_name)
                        }
                        /* Telegrams that do not carry the field keep the previous state:
                           numbers ignore an empty result, the others fall back to this.state. */
                        xsl:choose {
                            xsl:when(test = $problem) {
                                value_template = '{% if value_json.{attribute} is defined %}{{ "OFF" if value_json.{attribute} in ["OK", ""] else "ON" }}{% endif %}'
                                payload_on = ON
                                payload_off = OFF
                                device_class = problem
                                json_attributes_template = '{{ {"status": value_json.{attribute} if value_json.{attribute} is defined else this.attributes.get("status")} | tojson }}'
                            }
                            xsl:when(test = "$kind = 'number'") {
                                value_template = '{{ value_json.{attribute} if value_json.{attribute} is defined else "" }}'
                            }
                            xsl:when(test = "$kind = 'datetime'") {
                                value_template = '{{ (value_json.{attribute} | as_datetime | as_local).isoformat() if value_json.{attribute} is defined else this.state }}'
                            }
                            xsl:otherwise {
                                value_template = '{{ value_json.{attribute} if value_json.{attribute} is defined else this.state }}'
                            }
                        }
                        json_attributes_topic {
                            'wmbusmeters/'
                            xsl:value-of(select = $meter_name)
                        }
                        xsl:if(test = "not($problem)") {
                            icon = mdi:gauge
                        }
                        xsl:if(test = "$kind = 'number' and $hrunit != ''") {
                            unit_of_measurement {
                                xsl:value-of(select = $hrunit)
                            }
                        }
                        xsl:if(test = "$stateclass != ''") {
                            state_class {
                                xsl:value-of(select = $stateclass)
                            }
                        }
                        xsl:if(test = "$deviceclass != ''") {
                            device_class {
                                xsl:value-of(select = $deviceclass)
                            }
                        }
                        enabled_by_default = true
                    }
                }
            }
            // We are done with the dynamic fields, now fix the static fields.
            timestamp {
                component = sensor
                discovery_payload {
                    device {
                        identifiers(A)
                        {
                            _ {
                                'wmbusmeters_'
                                xsl:value-of(select = $meter_id)
                            }
                        }
                        manufacturer {
                            xsl:value-of(select = $manufacturer)
                        }
                        model {
                            xsl:value-of(select = $mvt)
                        }
                        name {
                            xsl:value-of(select = $meter_name)
                        }
                        serial_number {
                            xsl:value-of(select = $meter_id)
                        }
                    }
                    entity_category    = diagnostic
                    name               = timestamp
                    unique_id {
                            'wmbusmeters_'
                            xsl:value-of(select = $meter_id)
                            '_timestamp'
                    }
                    state_topic        = 'wmbusmeters/{name}'
                    value_template     = '{{ value_json.{attribute} }}'
                    icon               = mdi:calendar-clock
                    device_class       = timestamp
                    enabled_by_default = false
                }
            }
            rssi_dbm {
                component = sensor
                discovery_payload {
                    device {
                        identifiers(A)
                        {
                            _ {
                                'wmbusmeters_'
                                xsl:value-of(select = $meter_id)
                            }
                        }
                        manufacturer {
                            xsl:value-of(select = $manufacturer)
                        }
                        model {
                            xsl:value-of(select = $mvt)
                        }
                        name {
                            xsl:value-of(select = $meter_name)
                        }
                        serial_number = '{id}'
                    }
                    entity_category     = diagnostic
                    name                = rssi
                    unique_id           = 'wmbusmeters_{id}_{attribute}'
                    state_topic         = 'wmbusmeters/{name}'
                    value_template      = '{{ value_json.{attribute} }}'
                    icon                = mdi:signal
                    unit_of_measurement = dBm
                    state_class         = measurement
                    device_class        = signal_strength
                    enabled_by_default  = false
                }
            }
        }
    }
}
