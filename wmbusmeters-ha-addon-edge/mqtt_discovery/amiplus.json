  "total_energy_consumption_kwh":{
     "component":"sensor",
     "discovery_payload":{
        "device":{
           "identifiers":[
              "wmbusmeters_{id}"
           ],
           "manufacturer":"APATOR / ELGAMA ELEKTRONIKA",
           "model":"Electricity meter Apator EMU family / Elgama Gama 350 (driver: {driver})",
           "name":"{name}",
           "hw_version":"{id}"
        },
        "name":"total energy consumption",
        "unique_id":"wmbusmeters_{id}_{attribute}",
        "state_topic":"wmbusmeters/{name}",
        "value_template":"{{ value_json.{attribute} or ((value_json.total_energy_consumption_tariff_1_kwh | default(0)) + (value_json.total_energy_consumption_tariff_2_kwh | default(0)) + (value_json.total_energy_consumption_tariff_3_kwh | default(0)) + (value_json.total_energy_consumption_tariff_4_kwh | default(0))) }}",
        "json_attributes_topic":"wmbusmeters/{name}",
        "icon":"mdi:transmission-tower-import",
        "unit_of_measurement":"kWh",
        "state_class":"total_increasing",
        "device_class":"energy",
        "enabled_by_default":true
     }
  },
